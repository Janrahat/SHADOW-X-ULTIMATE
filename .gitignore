# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Reports generated at runtime (keep the directory, not its contents)
reports/*
!reports/.gitkeep
!reports/links.json

# Logs
*.log
logs/

# Local configuration overrides
config.local.json
.env
.env.*

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test and coverage artefacts
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Distribution bundles
*.zip
